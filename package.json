{
  "name": "dsh-theme-ascetic",
  "version": "0.3.2",
  "description": "ASCetic: a compact ASCII / terminal skin for DeepSeek Harness: monospace type, square box-drawing chrome, palettes, densities, a vim-style status line, ascii.rest hero art and chat bubbles.",
  "keywords": [
    "dsh-plugin",
    "dsh-theme",
    "deepseek-harness",
    "theme",
    "skin",
    "ascii",
    "compact",
    "terminal"
  ],
  "author": "TAB_mk <tabmk.contact[at]gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/TABmk/dsh-theme-ascetic#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TABmk/dsh-theme-ascetic.git"
  },
  "bugs": "https://github.com/TABmk/dsh-theme-ascetic/issues",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "ascii.rest": "0.4.0",
    "esbuild": "0.28.2"
  }
}
